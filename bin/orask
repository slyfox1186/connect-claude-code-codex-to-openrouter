#!/usr/bin/env bash
# CLI: ask another OpenRouter model for a second opinion.
set -euo pipefail

# Resolve this launcher to the project it lives in. The symlink walk is inline
# because through the ~/.local/bin symlink the shared helper is not findable
# yet, and readlink -f is GNU-only.
SELF="${BASH_SOURCE[0]}"
while [[ -L $SELF ]]; do
    LINK_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ $SELF == /* ]] || SELF="$LINK_DIR/$SELF"
done
PROJECT="$(cd -P "$(dirname "$SELF")/.." && pwd)"

source "$PROJECT/bin/_python-env.sh"

if ! orask_find_python "$PROJECT"; then
    echo "orask: no usable Python interpreter found." >&2
    echo "orask: run $PROJECT/install.sh, or set ORASK_PYTHON to an interpreter." >&2
    exit 1
fi

export PYTHONPATH="$PROJECT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m orask.cli "$@"
